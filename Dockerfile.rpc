FROM ubuntu:24.04 AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ cmake make pkg-config libfmt-dev libyaml-cpp-dev libboost-context-dev \
    libssl-dev libsqlite3-dev libgrpc++-dev libprotobuf-dev \
    protobuf-compiler protobuf-compiler-grpc && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN cmake -S . -B /build -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
    -DSYLAR_WITH_GRPC=ON -DSYLAR_BUILD_BENCHMARKS=OFF && \
    cmake --build /build --target catalog_server rpc_gateway -j2

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    libfmt9 libyaml-cpp0.8 libboost-context1.83.0 libssl3t64 libsqlite3-0 \
    libgrpc++1.51t64 libprotobuf32t64 ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*
COPY --from=build /build/sylar/catalog_server /build/sylar/rpc_gateway /usr/local/bin/
USER 65532:65532
ENV SYLAR_LISTEN_ADDRESS=0.0.0.0
EXPOSE 8080
CMD ["rpc_gateway", "8080", "catalog-a:50051,catalog-b:50051"]
